# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Frontend
node_modules/
app/dist/

# Rust / Tauri
app/src-tauri/target/
app/src-tauri/gen/
# Gebündelter Kern für den Installer (core/kern_bauen.py)
app/src-tauri/binaries/

# Lokale Daten (Roharchiv, Datenbanken) gehören nie ins Repository
daten/
*.sqlite
*.sqlite-*

# Probelauf mit dem Sprachmodell (juracore ki-pruefen)
ki-pruefen-daten/
ki-pruefen-protokoll.json
.venv-ci/

# macOS legt in jedem Ordner, den der Finder öffnet, eine .DS_Store an
.DS_Store

# Eigene Dateien zum Ausprobieren: bleiben auf dem Rechner und kommen nicht ins Repository.
# Die erfundenen Testdaten des Projekts liegen in testdaten/testakte-weber und testdaten/eigene-daten.
testdaten/*
!testdaten/testakte-weber/
!testdaten/eigene-daten/

# Hilfsprogramm für Apple Intelligence (macos/apple-ki/bauen.sh)
macos/apple-ki/build/
