  <norm builddate="20261115093000" doknr="BJNR000000001BJNE000200000">
    <metadaten>
      <jurabk>MustG</jurabk>
      <enbez>§ 1</enbez>
      <titel format="parat">Zweck</titel>
      <gliederungseinheit>
        <gliederungskennzahl>010010</gliederungskennzahl>
        <gliederungsbez>Abschnitt 1</gliederungsbez>
      </gliederungseinheit>
    </metadaten>
    <textdaten>
      <text format="XML">
        <Content>
          <P>(1) <SUP class="Rec">1</SUP>Mustertexte sind <B>sorgfältig</B> zu prüfen. <SUP class="Rec">2</SUP>Die Prüfung ist <I>schriftlich</I> festzuhalten.</P>
          <P>(2) Die Prüfung umfasst<DL Type="arabic">
              <DT>1.</DT>
              <DD Font="normal"><LA Size="normal">die Form,</LA></DD>
              <DT>2.</DT>
              <DD Font="normal"><LA Size="normal">den Inhalt, insbesondere<DL Type="alpha">
                    <DT>a)</DT>
                    <DD Font="normal"><LA Size="normal">die Vollständigkeit und</LA></DD>
                    <DT>b)</DT>
                    <DD Font="normal"><LA Size="normal">die Richtigkeit,</LA></DD>
                  </DL>soweit nichts anderes bestimmt ist, und</LA></DD>
              <DT>3.</DT>
              <DD Font="normal"><LA Size="normal">die Frist<FnR ID="F1"/>.</LA></DD>
            </DL></P>
          <P>(3) Zuständig ist die Prüfstelle.<BR/>Sie entscheidet nach Anhörung.</P>
        </Content>
        <Footnotes>
          <Footnote ID="F1" FnZ="1">Frist im Sinne des § 3.</Footnote>
        </Footnotes>
      </text>
    </textdaten>
  </norm>
