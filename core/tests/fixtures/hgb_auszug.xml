  <norm builddate="20260901120000" doknr="BJNR002190897BJNE034302377">
    <metadaten>
      <jurabk>HGB</jurabk>
      <enbez>§ 343</enbez>
      <titel format="parat">Begriff der Handelsgeschäfte</titel>
    </metadaten>
    <textdaten><text format="XML"><Content>
      <P>Handelsgeschäfte sind alle Geschäfte eines Kaufmanns, die zum Betriebe seines Handelsgewerbes gehören.</P>
    </Content></text></textdaten>
